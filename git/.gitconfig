[user]
	email = mreddy7@deloitte.com
	name = mreddy7_deloitte
	signingkey = /home/mreddy7/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = less
[alias]
    tree = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/mreddy7/.ssh/allowed_signers
[commit]
	gpgsign = true
[push]
	default = current
[maintenance]
	repo = /home/mreddy7/DSS-5.0
